{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "panopath",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-23",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
